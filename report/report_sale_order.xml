<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="report_saleorder_document_itc" inherit_id="sale.report_saleorder_document">

    <!-- Cabeçalho - Indicação de Via -->
    <xpath expr="//t/div[@class='page']/h2" position="before">
      <span style="float:right;font-size:11px;margin-top:9px">
          Original
      </span>
    </xpath>

    <!-- Título do Documento -->
    <xpath expr="//t/div[@class='page']/h2" position="replace">
      <h2>
        <t t-if="not doc.certificated">
          <t t-if="doc.state == 'cancel'">
            <span>Rascunho Cancelado</span>
          </t>
          <t t-if="not doc.state == 'cancel'">
            <span>Rascunho</span>
          </t>
        </t>
        <t t-if="doc.certificated">
          <t t-if="not doc.state == 'cancel'">
            <span t-if="doc.type_doc == 'OR' and 'OR' in doc.name">Orçamento nº </span>
            <span t-if="doc.type_doc == 'NE' and 'OR' not in doc.name">Nota de Encomenda nº </span>
            <span t-if="doc.type_doc == 'PP'">Pro-Forma nº </span>
            <span t-if="doc.type_doc == 'FC'">Factura de Consignação nº </span>
          </t>
          <t t-if="doc.state == 'cancel'">
            <span t-if="doc.type_doc == 'OR' and 'OR' in doc.name">Orçamento Cancelado nº </span>
            <span t-if="doc.type_doc == 'NE' and 'OR' not in doc.name">Nota de Encomenda Cancelada nº </span>
            <span t-if="doc.type_doc == 'PP'">Pro-Forma Cancelada nº </span>
            <span t-if="doc.type_doc == 'FC'">Factura de Consignação Cancelada nº </span>
          </t>
        </t>
        <span t-field="doc.name"/>
      </h2>
    </xpath>

    <!-- Informações -->
    <xpath expr="//t/div[@class='page']/div[@id='informations']" position="replace">
      <div id="informations" class="row mt-3 mb-1"
           style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.date_order">
          <strong>Data de Emissão:</strong><br/>
          <span t-field="doc.date_order"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.validity_date">
          <strong>Vencimento:</strong><br/>
          <span t-field="doc.validity_date"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.client_order_ref">
          <strong>Doc. de Origem:</strong><br/>
          <span t-field="doc.client_order_ref"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.partner_id.vat">
          <strong>V/N.º Contrib:</strong><br/>
          <span t-field="doc.partner_id.vat"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.pricelist_id.currency_id">
          <strong>Moeda:</strong><br/>
          <span t-field="doc.pricelist_id.currency_id.name"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.user_id">
          <strong>Utilizador:</strong><br/>
          <span t-field="doc.user_id.name"/>
        </div>
      </div>
    </xpath>

    <!-- Quadro de Impostos e Totais -->
    <xpath expr="//t/div/div/div[@id='total']" position="replace">
      <div id="total" class="row mt-4" style="font-size:9pt;">

        <!-- Quadro de Impostos -->
        <div class="col-8 pull-left" style="margin-bottom:20px;">
          <table class="table table-sm" style="border:1px solid #000; page-break-inside: avoid;">
            <thead>
              <tr style="background:#f2f2f2;">
                <th colspan="3" class="text-center"><strong>QUADRO DE IMPOSTOS</strong></th>
              </tr>
              <tr>
                <th class="text-center">Taxa %</th>
                <th class="text-center">Valor Base</th>
                <th class="text-center">Total Imposto</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="doc.amount_by_group" t-as="tax_group">
                <td class="text-center"><span t-esc="tax_group[0]"/></td>
                <td class="text-right"><span t-esc="tax_group[4]"/></td>
                <td class="text-right"><span t-esc="tax_group[3]"/></td>
              </tr>
            </tbody>
          </table>

          <!-- Motivo de Isenção -->
          <div class="row mt-2" style="font-size:9pt">
            <div class="col-12">
              <t t-foreach="doc.order_line.mapped('tax_id')" t-as="tax">
                <p t-if="tax.saft_tax_code == 'ISE' and tax.exemption_reason"
                   style="font-weight:bold; color:#000000;">
                  Produto/serviço isento ao abrigo do motivo:
                  <span t-esc="tax.exemption_reason"/>
                </p>
              </t>
            </div>
          </div>

          <!-- Hash + Aviso -->
          <div class="row mt-3" style="font-size:9pt; color:#000000;">
            <div class="col-12">
              <p t-if="doc.hash">
                <span>
                  <span t-esc="doc.hash[0:1]"/><span t-esc="doc.hash[10:11]"/>
                  <span t-esc="doc.hash[20:21]"/><span t-esc="doc.hash[30:31]"/>
                  - Processado por programa validado nº 000/AGT/2025 - InvoiceOne ERP
                </span>
              </p>

              <p style="font-weight:bold; color:#000000; margin-top:5px;">
                Este Documento não serve como Factura.
              </p>
            </div>
          </div>
        </div>

        <!-- Quadro de Totais -->
        <div class="col-4 pull-right">
        <br/><br/><br/><br/><br/><br/><br/><br/>
          <table class="table table-sm" style="border:1px solid #bcb4b4ff; font-size:9pt; page-break-inside: avoid;">
            <tr>
              <td><strong>Total Ilíquido</strong></td>
              <td class="text-right"><span t-field="doc.amount_untaxed"/></td>
            </tr>
            <tr>
              <td>Total de Imposto</td>
              <td class="text-right"><span t-field="doc.amount_tax"/></td>
            </tr>
            <tr style="background:#004080; color:#fff;">
              <td><strong>Total do Documento</strong></td>
              <td class="text-right">
                <span class="text-nowrap" t-field="doc.amount_total"/>
              </td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Rodapé - Coordenadas Bancárias -->
      <div class="row mt-4" style="font-size:9pt; color:#000000; border-top:1px solid #000; padding-top:8px;">
        <div class="col-12" style="font-family: Arial, Helvetica, sans-serif;">
          <p><strong>Coordenadas Bancárias:</strong></p>
          <ul style="margin-left:15px;">
            <li><strong>Banco Fomento Angola</strong>: IBAN AO06 0006 0000 0725 2528 3016 4</li>
            <li><strong>Banco Millennium Atlântico</strong>: IBAN AO06 0055 0000 2168 9336 1011 5</li>
          </ul>
        </div>
      </div>
    </xpath>

  </template>

  <template id="sale.report_saleorder">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-set="lang" t-value="doc.partner_id.lang"/>
        <t t-call="sale.report_saleorder_document" t-lang="lang"/>
      </t>
    </t>
  </template>

</odoo>