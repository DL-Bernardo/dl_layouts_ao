<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_bank_form_inherit_iban" model="ir.ui.view">
            <field name="name">res.partner.bank.form.inherit.iban</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='acc_number' or @name='account_number']" position="after">
                    <field name="iban" placeholder="AO06 0000 0000 0000 0000 0000 0"/>
                </xpath>
            </field>
        </record>

        <record id="view_partner_bank_tree_inherit_iban" model="ir.ui.view">
            <field name="name">res.partner.bank.tree.inherit.iban</field>
            <field name="model">res.partner.bank</field>
            <field name="inherit_id" ref="base.view_partner_bank_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='acc_number' or @name='account_number']" position="after">
                    <field name="iban" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
