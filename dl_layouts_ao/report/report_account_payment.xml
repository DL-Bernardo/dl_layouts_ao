<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="report_payment_document_custom" inherit_id="account.report_payment_receipt_document">
      <xpath expr="//div[hasclass('page')]" position="replace">
        <div class="page" style="font-family: Arial, Helvetica, sans-serif;">
          <div class="row mt16" style="font-family: Arial, Helvetica, sans-serif; align-items: flex-start;">
            <div class="col-6">
              <h3 style="margin-top:20px; font-size:20px;">
                <strong>
                  Recibo: <span t-field="o.name"/>
                </strong>
              </h3>
            </div>
            <div class="col-6" style="text-align:right;">
              <div style="border:2px solid #000000; border-radius:6px; padding:8px;
                          font-size:10pt; line-height:1.3; min-height:86px;
                          width:280px; display:inline-block; text-align:left;">
                <div>
                  <strong>Exmo. (a) Sr. (a): </strong>
                  <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.street">
                  <strong>Morada: </strong> <span t-field="o.partner_id.street"/>
                </div>
                <div t-if="o.partner_id.city">
                  <strong>Cidade:</strong> <span t-field="o.partner_id.city"/>
                </div>
                <div t-if="o.partner_id.country_id">
                  <strong>País: </strong><span t-field="o.partner_id.country_id.name"/>
                </div>
                <div t-if="o.partner_id.vat">
                  <strong>NIF: </strong><span t-field="o.partner_id.vat"/>
                </div>
              </div>
            </div>
          </div>

          <hr style="border:1px solid #000000; margin-top:10px; margin-bottom:15px;"/>

          <div class="row mt4 mb8" style="font-size:10pt; font-family:Arial, Helvetica, sans-serif;">
            <div class="col-auto" style="margin-right:30px;">
              <strong>Data de Pagamento:</strong><br/>
              <span t-field="o.date"/>
            </div>
            <div class="col-auto" style="margin-right:30px;">
              <strong>V/N.º Contrib:</strong><br/>
              <span t-if="o.partner_id.vat and o.partner_id.vat != '999999999'" t-field="o.partner_id.vat"/>
              <span t-if="o.partner_id.vat == '999999999'">Consumidor Final</span>
            </div>
            <div class="col-auto" style="margin-right:30px;">
              <strong>Método de Pagamento:</strong><br/>
              <span t-field="o.journal_id.name"/>
            </div>
            <div class="col-auto" t-if="o._fields.get('ref') and o.ref">
              <strong>V/Ref.:</strong><br/>
              <span t-field="o.ref"/>
            </div>
          </div>

          <t t-set="rec_invoices" t-value="o._fields.get('reconciled_invoice_ids') and o.reconciled_invoice_ids or []"/>
          <table class="table table-sm table-bordered" style="margin-top: 20px; font-size:9pt;">
            <thead style="background:#f2f2f2;">
              <tr>
                <th class="text-left"><strong>Factura</strong></th>
                <th class="text-left"><strong>Data</strong></th>
                <th class="text-right"><strong>Valor da Factura</strong></th>
                <th class="text-right"><strong>IVA</strong></th>
                <th class="text-right"><strong>Retenção</strong></th>
                <th class="text-right"><strong>Valor Pago</strong></th>
                <th class="text-right"><strong>Valor em Dívida</strong></th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="rec_invoices" t-as="inv">
                <tr>
                  <td><span t-field="inv.name"/></td>
                  <td><span t-field="inv.invoice_date"/></td>
                  <td class="text-right">
                    <span t-field="inv.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                  </td>
                  <td class="text-right">
                    <span t-field="inv.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                  </td>
                  <td class="text-right">
                    <t t-if="inv._fields.get('withholding_amount') and inv.withholding_amount &gt; 0">
                      <span t-field="inv.withholding_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </t>
                  </td>
                  <td class="text-right">
                    <span t-esc="abs(o.amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                  </td>
                  <td class="text-right">
                    <span t-field="inv.amount_residual" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>

          <div class="row mt8">
            <div class="col-12 text-end">
              <p style="font-size:16pt; font-weight:bold; color:#002060; border-top:2px solid #000000;
                        display:inline-block; padding-top:5px;">
                TOTAL PAGO:
                <span t-esc="abs(o.amount)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
              </p>
            </div>
          </div>

          <div class="row mt16 mb8" style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
            <div class="col-12">
              <p style="font-weight:bold;">Este documento não serve como factura.</p>
            </div>
          </div>

        </div>
      </xpath>
    </template>
  </data>
</odoo>
