<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_delivery_oc_aov17">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-set="n_copies" t-value="int(o.company_id.n_copies_picking or 1)"/>
                    <t t-foreach="range(n_copies)" t-as="n_pages">
                        <t t-set="page_n" t-value="n_pages+1"/>
                        <t t-call="stock.report_picking" t-lang="lang"/>
                    </t>
                </t>
            </t>
        </template>

        <record id="stock.action_report_delivery" model="ir.actions.report">
            <field name="report_name">dl_layouts_ao.report_delivery_oc_aov17</field>
        </record>

        <record id="stock.action_report_picking" model="ir.actions.report">
            <field name="report_name">dl_layouts_ao.report_delivery_oc_aov17</field>
        </record>

        <template id="report_picking_opc_aov17" inherit_id="stock.report_picking">

            <xpath expr="//div[@name='div_origin']/strong" position="replace">
                <strong>Ref. Doc Origem:</strong>
            </xpath>

            <xpath expr="//div[@name='div_sched_date']" position="replace">
                <div class="col-auto" t-if="o.scheduled_date" name="div_sched_date">
                    <strong>Data Agendada:</strong>
                    <p t-if="o.state != 'done'" t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                    <p t-if="o.state == 'done'" t-field="o.date_done" t-options='{"widget": "date"}'/>
                </div>
            </xpath>

            <xpath expr="//div[@name='div_sched_date']" position="before">
                <div class="col-auto" t-if="o.partner_id" name="vat">
                    <strong>V/Nº. Contribuinte</strong>
                    <p t-if="o.partner_id.commercial_partner_id.vat != '999999990'">
                        <span t-field="o.partner_id.commercial_partner_id.vat"/>
                    </p>
                    <p t-if="o.partner_id.commercial_partner_id.vat == '999999990'">Consumidor Final</p>
                </div>
            </xpath>

            <xpath expr="//div[hasclass('page')]" position="inside">
                <div class="row mt-4" style="page-break-inside: avoid;">
                    <div class="col-12" style="padding-top: 20px;">
                        <div style="text-align: justify; font-size: 9pt;">
                            <p><strong>Processado por programa certificado n.º FE/85/AGT/2025</strong> - <strong>InvoiceOne</strong></p>
                        </div>
                    </div>
                </div>

                <div class="row mt-5" style="margin-top: 50px !important;">
                    <div class="col-6"><p>Entreguei: _____________________________</p></div>
                    <div class="col-6"><p>Recebi: _____________________________</p></div>
                </div>

                <div class="row">
                    <div class="col-12 mt16">
                        <div style="text-align: justify;">
                            <t t-if="o.state != 'done'">
                                <p>Este Documento não serve como Factura.</p>
                            </t>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>
    </data>
</odoo>
