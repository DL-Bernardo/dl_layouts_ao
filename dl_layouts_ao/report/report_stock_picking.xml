<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Template principal com múltiplas cópias -->
        <template id="report_delivery_oc_aov17">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-set="n_copies" t-value="int(o.company_id.n_copies_picking)"/>
                    <t t-foreach="range(n_copies)" t-as="n_pages">
                        <t t-set="page_n" t-value="n_pages+1"/>
                        <t t-call="stock.report_picking" t-lang="lang"/>
                    </t>
                </t>
            </t>
        </template>

        <!-- Redefinição das ações de relatório para usar o novo template -->
        <record id="stock.action_report_delivery" model="ir.actions.report">
            <field name="report_name">opc_layouts_aov17.report_delivery_oc_aov17</field>
        </record>

        <record id="stock.action_report_picking" model="ir.actions.report">
            <field name="report_name">opc_layouts_aov17.report_delivery_oc_aov17</field>
        </record>

        <!-- Herança do template padrão com modificações -->
        <template id="report_picking_opc_aov17" inherit_id="stock.report_picking">

            <!-- Adiciona VAT do cliente antes da data programada -->
            <xpath expr="//div[@name='div_sched_date']" position="before">
                <div class="col-auto" t-if="o.partner_id" name="vat">
                    <strong>V/Nº. Contribuinte</strong>
                    <p t-if="o.partner_id.commercial_partner_id.vat != '999999990'">
                        <span t-field="o.partner_id.commercial_partner_id.vat"/>
                    </p>
                    <p t-if="o.partner_id.commercial_partner_id.vat == '999999990'">Consumidor Final</p>
                </div>
            </xpath>

            <!-- Conteúdo personalizado adicional -->
            <xpath expr="//div[@class='page']" position="inside">
                <div class="row">
                    <div class="col-6">
                        <t t-if="o.picking_type_id.code == 'internal'">
                            <div style="text-align: justify;">
                                <p>
                                    <b>Data Carga:</b>
                                    <span t-if="o.data_carga">
                                        <span t-field="o.data_carga" t-field-options='{"format": "yyyy/dd/MM HH:mm"}'/>h
                                    </span>

                                    <span t-if="o.usar_dados_empresa">
                                        <br/>
                                        <b>Local de Carga:</b>
                                        <t t-set="verificar_group_locations" t-value="0"/>
                                        <t t-if="o.location_dest_id.name" groups="stock.group_locations">
                                            <t t-set="verificar_group_locations" t-value="1"/>
                                            <t t-if="o.location_id.usage == 'internal'">
                                                <span t-esc="o.picking_type_id.warehouse_id.name"/> - <span t-esc="o.location_id.name"/>
                                            </t>
                                            <t t-if="o.picking_type_id.code == 'incoming'">V/ Armazém</t>
                                            <t t-if="not o.picking_type_id.code == 'incoming' and not o.location_id.usage == 'internal'">N/ Armazém</t>
                                        </t>
                                        <t t-if="o.picking_type_id.code == 'incoming' and verificar_group_locations == 0">V/ Armazém</t>
                                        <t t-if="not o.picking_type_id.code == 'incoming' and verificar_group_locations == 0">N/ Armazém</t>
                                    </span>

                                    <span t-if="not o.usar_dados_empresa">
                                        <br/>
                                        <b>Local Carga:</b>
                                        <span t-field="o.carga_rua"/><br/>
                                        <span t-field="o.carga_cp"/> <span t-field="o.carga_cidade"/><br/>
                                        <span t-field="o.carga_pais and o.carga_pais.name"/>
                                    </span>

                                    <span t-if="o.usar_dados_client">
                                        <br/>
                                        <b>Local de Descarga:</b>
                                        <t t-set="verificar_group_locations" t-value="0"/>
                                        <t t-if="o.location_dest_id.name" groups="stock.group_locations">
                                            <t t-set="verificar_group_locations" t-value="1"/>
                                            <t t-if="o.location_dest_id.usage == 'internal'">
                                                <span t-esc="o.picking_type_id.warehouse_id.name"/> - <span t-esc="o.location_dest_id.name"/>
                                            </t>
                                            <t t-if="not o.location_dest_id.usage == 'internal'">V/ Armazém</t>
                                        </t>
                                        <t t-if="o.picking_type_id.code == 'incoming' and verificar_group_locations == 0">N/ Armazém</t>
                                        <t t-if="not o.picking_type_id.code == 'incoming' and verificar_group_locations == 0">V/ Armazém</t>
                                    </span>

                                    <br/>
                                    <b>Veículo:</b> <span t-esc="o.veiculo"/>
                                </p>
                            </div>
                        </t>
                    </div>

                    <t t-if="o.picking_type_id.code == 'internal'">
                        <div class="col-6">
                            <div style="text-align: justify;" t-if="not o.usar_dados_client">
                                <p>
                                    <b>Data Descarga:</b>
                                    <span t-if="o.data_descarga">
                                        <span t-field="o.data_descarga" t-field-options='{"format": "yyyy/dd/MM HH:mm"}'/>h
                                    </span>
                                    <br/>
                                    <b>Local Descarga:</b>
                                    <span t-field="o.descarga_rua"/><br/>
                                    <span t-field="o.descarga_cp"/> <span t-field="o.descarga_cidade"/><br/>
                                    <span t-field="o.descarga_pais and o.descarga_pais.name"/>
                                </p>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Hash e assinatura -->
                <div class="row">
                    <div class="col-12">
                        <div style="text-align: justify;">
                            <t t-if="o.hash and o.state == 'done'">
                                <p>
                                    <span t-esc="o.hash[0:1]"/><span t-esc="o.hash[10:11]"/><span t-esc="o.hash[20:21]"/><span t-esc="o.hash[30:31]"/>
                                    - Processado por programa validado nº 205/AGT/2025 - CE ERP
                                </p>
                            </t>
                        </div>
                    </div>
                </div>

                <br/>

                <div class="row">
                    <div class="col-6"><p>Entreguei: _____________________________</p></div>
                    <div class="col-6"><p>Recebi: _____________________________</p></div>
                </div>

                <div class="row">
                    <div class="col-12 mt16">
                        <div style="text-align: justify;">
                            <t t-if="o.state != 'done'">
                                <p>Este Documento não serve como Factura.</p>
                            </t>
                            <t t-if="o.manual and o.origin">
                                <p>Cópia do Documento Original - <span t-field="o.company_id.name"/>.</p>
                            </t>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>
    </data>
</odoo>
