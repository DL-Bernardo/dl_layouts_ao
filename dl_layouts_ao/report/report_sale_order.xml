<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_saleorder_document_itc" inherit_id="sale.report_saleorder_document">

    <xpath expr="//th[@name='th_quantity']" position="replace">
      <th name="th_quantity" class="text-end">QTD</th>
    </xpath>
    <xpath expr="//th[@name='th_quantity']" position="after">
      <th name="th_uom" class="text-end">UN.</th>
    </xpath>
    <xpath expr="//td[@name='td_quantity' or @name='td_product_quantity']" position="replace">
      <td name="td_quantity" class="text-end">
        <span t-field="line.product_uom_qty"/>
      </td>
      <td name="td_uom" class="text-end">
        <span t-out="line._fields.get('product_uom') and line.product_uom.name or (line._fields.get('product_uom_id') and line.product_uom_id.name or '')"/>
      </td>
    </xpath>

    <xpath expr="//th[@name='th_priceunit']" position="replace">
      <th name="th_priceunit" class="text-end text-nowrap">P.UNITÁRIO</th>
    </xpath>
    <xpath expr="//th[@name='th_subtotal']" position="replace">
      <th name="th_subtotal" class="text-end">TOTAL</th>
    </xpath>

    <xpath expr="//div[@id='informations']" position="before">
      <h2>
        <t t-set="p_count" t-value="hasattr(doc, 'action_get_print_count') and doc.action_get_print_count() or 1"/>
        <span style="float:right;font-size:11px;margin-top:9px">
          <t t-if="not p_count or p_count &lt;= 1">Original</t>
          <t t-else="">Original (<t t-esc="p_count"/>ª Via)</t>
        </span>
        <t t-set="is_cert" t-value="doc._fields.get('certificated') and doc.certificated or True"/>
        <t t-set="tdoc" t-value="doc._fields.get('type_doc') and doc.type_doc or 'OR'"/>
        <t t-if="not is_cert">
          <span t-if="doc.state == 'cancel'">Rascunho Cancelado </span>
          <span t-else="">Rascunho </span>
        </t>
        <t t-if="is_cert">
          <t t-if="doc.state != 'cancel'">
            <span t-if="tdoc == 'OR'">Orçamento nº </span>
            <span t-elif="tdoc == 'NE'">Nota de Encomenda nº </span>
            <span t-elif="tdoc == 'PP'">Pro-Forma nº </span>
            <span t-elif="tdoc == 'FC'">Factura de Consignação nº </span>
          </t>
          <t t-else="">
            <span t-if="tdoc == 'OR'">Orçamento Cancelado nº </span>
            <span t-elif="tdoc == 'NE'">Nota de Encomenda Cancelada nº </span>
            <span t-elif="tdoc == 'PP'">Pro-Forma Cancelada nº </span>
            <span t-elif="tdoc == 'FC'">Factura de Consignação Cancelada nº </span>
          </t>
        </t>
        <span t-field="doc.name"/>
      </h2>
    </xpath>

    <xpath expr="//div[@id='informations']" position="replace">
      <div id="informations" class="row mt-3 mb-1"
           style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.date_order">
          <strong>Data de Emissão:</strong><br/>
          <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.validity_date">
          <strong>Vencimento:</strong><br/>
          <span t-field="doc.validity_date"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.client_order_ref">
          <strong>Doc. de Origem:</strong><br/>
          <span t-field="doc.client_order_ref"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.partner_id.vat">
          <strong>V/N.º Contrib:</strong><br/>
          <span t-field="doc.partner_id.vat"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.currency_id">
          <strong>Moeda:</strong><br/>
          <span t-field="doc.currency_id.name"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="doc.user_id">
          <strong>Utilizador:</strong><br/>
          <span t-field="doc.user_id.name"/>
        </div>
      </div>
    </xpath>

    <xpath expr="//div[@id='total']" position="after">
      <div class="row mt-4 text-center" style="font-size:9pt; color:#000; page-break-inside: avoid; clear: both;">
        <div class="col-12">
          <p style="margin-bottom:5px; color: #000;">
            <strong style="color: #000;">Documento emitido por programa certificado n.º FE/85/AGT/2025 - InvoiceOne</strong>
          </p>
          <p style="font-weight:bold; color:#000000; margin-top:0px;">
            Este Documento não serve como Factura.
          </p>
        </div>
      </div>

      <div class="row mt-4" style="font-size:9pt; color:#000000; border-top:1px solid #000; padding-top:8px;">
        <div class="col-12" style="font-family: Arial, Helvetica, sans-serif;">
          <t t-if="doc.company_id.partner_id.bank_ids">
            <p><strong>Coordenadas Bancárias:</strong></p>
            <ul style="margin-left:15px; list-style-type: none; padding-left: 0;">
              <t t-foreach="doc.company_id.partner_id.bank_ids" t-as="bank">
                <li style="margin-bottom: 2px;">
                  <strong t-esc="bank.bank_id.name or 'Banco'"/>:
                  <t t-if="bank.acc_number and bank._fields.get('iban') and bank.iban">
                    <span>N.º de conta: <t t-esc="bank.acc_number"/> | IBAN: <t t-esc="bank.iban"/></span>
                  </t>
                  <t t-elif="bank._fields.get('iban') and bank.iban">
                    <span>IBAN: <t t-esc="bank.iban"/></span>
                  </t>
                  <t t-elif="bank.acc_number">
                    <span><t t-esc="bank.acc_number"/></span>
                  </t>
                </li>
              </t>
            </ul>
          </t>
        </div>
      </div>
    </xpath>

  </template>
</odoo>
