<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_invoice_document_layouts_aov17" inherit_id="account.report_invoice_document">

    <!-- Cabeçalho -->
    <xpath expr="//div[@id='informations']" position="before">
      <div t-if="o.partner_id.id" class="col-12" style="font-family: Arial, Helvetica, sans-serif; color:#000000; font-size:10px;">
        <h3 style="margin-bottom:0px;font-size:18px">
          <span style="float:right;font-size:11px;margin-top:9px">
            <t t-set="p_count" t-value="get_is_printed(o) if 'get_is_printed' in locals() else (o.print_count or 1)"/>
            <span t-if="not p_count or p_count &lt;= 1">Original</span>
            <span t-else="">Original (<t t-esc="p_count"/>ª Via)</span>
          </span>

          <t t-set="saft_type" t-value="o.journal_id._fields.get('saft_inv_type') and o.journal_id.saft_inv_type or 'FT'"/>
          <h2>
            <span t-if="o.move_type == 'out_invoice' and saft_type not in ('VD', 'ND', 'FR', 'FA') and o.state == 'posted'">Factura</span>
            <span t-if="o.state == 'draft'">Nota Informativa</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type not in ('FA', 'ND', 'FR', 'VD') and o.state == 'cancel'">Factura Anulada</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'FA' and o.state == 'posted'">Factura de Adiantamento</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'FA' and o.state == 'cancel'">Factura de Adiantamento Anulada</span>
            <span t-if="o.move_type == 'out_refund' and saft_type != 'NCA' and o.state == 'posted'">Nota de Crédito</span>
            <span t-if="o.move_type == 'out_refund' and saft_type == 'NCA' and o.state == 'posted'">Nota de Crédito de Adiantamento</span>
            <span t-if="o.move_type == 'in_refund' and o.state == 'posted'">Nota de Crédito</span>
            <span t-if="o.move_type == 'in_invoice' and o.state == 'posted'">Factura</span>
            <span t-if="o.move_type == 'in_invoice' and o.state == 'cancel'">Factura Anulada</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'VD' and o.state == 'posted'">Factura</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'VD' and o.state == 'cancel'">Factura Anulada</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'ND' and o.state == 'posted'">Nota de Débito</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'ND' and o.state == 'cancel'">Nota de Débito Anulada</span>
            <span t-if="o.move_type == 'out_refund' and saft_type != 'NCA' and o.state == 'cancel'">Nota de Crédito Anulada</span>
            <span t-if="o.move_type == 'out_refund' and saft_type == 'NCA' and o.state == 'cancel'">Nota de Crédito de Adiantamento Anulada</span>
            <span t-if="o.move_type == 'in_refund' and o.state == 'cancel'">Nota de Crédito Anulada</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'FR' and o.state == 'posted'">Factura/Recibo</span>
            <span t-if="o.move_type == 'out_invoice' and saft_type == 'FR' and o.state == 'cancel'">Factura/Recibo Anulado</span>

            <span t-if="o.name and o.state != 'draft'">
              nº <span t-field="o.name"/>
            </span>
          </h2>
        </h3>
      </div>
    </xpath>

    <!-- Informações -->
    <xpath expr="//div[@id='informations']" position="replace">
      <t t-set="saft_type" t-value="o.journal_id._fields.get('saft_inv_type') and o.journal_id.saft_inv_type or 'FT'"/>
      <div id="informations" class="row mt-3 mb-1" style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
        <div class="col-auto col-3 mw-100 mb-2" t-if="o.date">
          <strong>Data de Emissão:</strong><br/>
          <span t-field="o.date"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_due">
          <strong>Vencimento:</strong><br/>
          <span t-field="o.invoice_date_due"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="(o.move_type in ('out_refund','in_refund') or (o.move_type == 'out_invoice' and saft_type == 'ND')) and o.invoice_origin" name="origin">
          <strong>Doc. de Origem:</strong><br/>
          <span t-field="o.invoice_origin"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="o.partner_id.vat">
          <strong>V/N.º Contrib:</strong><br/>
          <span t-field="o.partner_id.vat"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="o.currency_id">
          <strong>Moeda:</strong><br/>
          <span t-field="o.currency_id.name"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="o.create_uid">
          <strong>Utilizador:</strong><br/>
          <span t-field="o.create_uid.name"/>
        </div>
        <div class="col-auto col-3 mw-100 mb-2" t-if="(o.move_type in ('out_refund','in_refund') or (o.move_type == 'out_invoice' and saft_type == 'ND')) and o.ref">
          <strong>Referência:</strong><br/>
          <span t-field="o.ref"/>
        </div>
      </div>
    </xpath>

    <!-- Linhas da fatura -->
    <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="replace">
      <tr style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
        <th name="th_description" class="text-start">DESCRIÇÃO</th>
        <th name="th_quantity" class="text-end">QTD</th>
        <th name="th_uom" class="text-end">UN.</th>
        <th name="th_priceunit" class="text-end">P.UNITÁRIO</th>
        <th name="th_discount" t-if="display_discount" class="text-end">DESC.%</th>
        <th name="th_taxes" class="text-end">IMPOSTOS</th>
        <th name="th_subtotal" class="text-end">TOTAL</th>
      </tr>
    </xpath>

    <xpath expr="//table[@name='invoice_line_table']/tbody" position="replace">
      <tbody class="invoice_tbody" style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
        <t t-foreach="lines" t-as="line">
          <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
            <t t-if="line.display_type in ('product', False)">
              <td name="account_invoice_line_name"><span t-field="line.name"/></td>
              <td name="td_quantity" class="text-end"><span t-field="line.quantity"/></td>
              <td name="td_uom" class="text-end"><span t-out="line._fields.get('product_uom_id') and line.product_uom_id.name or ''"/></td>
              <td name="td_priceunit" class="text-end"><span t-field="line.price_unit"/></td>
              <td name="td_discount" t-if="display_discount" class="text-end"><span t-field="line.discount"/></td>
              <td name="td_taxes" class="text-end"><t t-set="taxes" t-value="', '.join([(getattr(tax, 'invoice_label', False) or tax.name) for tax in line.tax_ids])"/><span t-out="taxes"/></td>
              <td name="td_subtotal" class="text-end"><span t-field="line.price_subtotal"/></td>
            </t>
            <t t-elif="line.display_type == 'line_section'"><td colspan="99"><span t-field="line.name"/></td></t>
            <t t-elif="line.display_type == 'line_note'"><td colspan="99"><span t-field="line.name"/></td></t>
          </tr>
        </t>
      </tbody>
    </xpath>

    <!-- QUADROS E TOTAIS -->
    <xpath expr="//div[@id='total']" position="replace">
      <t t-set="wht_amt" t-value="o._fields.get('withholding_amount') and o.withholding_amount or 0.0"/>
      <t t-set="payment_vals" t-value="{}"/>
      <div id="total" class="row mt-3" style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000;">
        <i class="d-none oe_payment_label"/>
        <div class="col-7">
          <t t-if="o._fields.get('amount_by_group') and o.amount_by_group">
            <table class="table table-sm table-bordered" style="page-break-inside: avoid; margin-bottom: 15px; border:1px solid #ddd;">
              <thead>
                <tr><th colspan="3" class="text-center bg-light"><strong>QUADRO DE IMPOSTO</strong></th></tr>
                <tr><th class="text-center">TAXA %</th><th class="text-center">VALOR BASE</th><th class="text-center">TOTAL IMPOSTO</th></tr>
              </thead>
              <tbody>
                <tr t-foreach="o.amount_by_group" t-as="amount_by_group">
                  <td class="text-center"><span t-esc="amount_by_group[0]"/></td>
                  <td class="text-right"><span t-esc="amount_by_group[4]"/></td>
                  <td class="text-right"><span t-esc="amount_by_group[3]"/></td>
                </tr>
              </tbody>
            </table>
          </t>
        </div>
        <div class="col-5 ms-auto">
          <table class="table table-sm" style="border:1px solid #ddd;">
            <t t-set="total_discount" t-value="sum([l.quantity * l.price_unit * (l.discount / 100.0) for l in o.invoice_line_ids if l.discount])"/>
            <t t-if="total_discount &gt; 0">
              <tr>
                <td style="font-weight:bold;">Total de Desconto</td>
                <td class="text-end"><span t-esc="total_discount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
              </tr>
            </t>
            <tr><td style="font-weight:bold;">Total Ilíquido</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
            <tr><td style="font-weight:bold;">Total de Imposto</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
            <tr style="background-color:#f2f2f2;"><td style="font-weight:bold;">Total do Documento</td><td class="text-end fw-bold"><span t-field="o.amount_total"/></td></tr>
            <t t-if="wht_amt &gt; 0">
              <tr><td style="font-weight:bold;">Retenção na Fonte</td><td class="text-end"><span t-esc="wht_amt" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
              <tr style="background-color:#f2f2f2;"><td style="font-weight:bold;">Líquido a Pagar</td><td class="text-end fw-bold"><span t-esc="o._fields.get('net_amount') and o.net_amount or (o.amount_total - wht_amt)" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
            </t>
          </table>
        </div>
      </div>

      <!-- Rodapé Bancário e Avisos -->
      <div class="row mt16" style="font-family: Arial, Helvetica, sans-serif; font-size:9pt; color:#000000; border-top:1px solid #000; padding-top:8px;">
        <div class="col-12" style="text-align: justify;">
          <t t-if="o.company_id.partner_id.bank_ids">
            <p><strong>Coordenadas Bancárias:</strong></p>
            <ul style="margin-left:15px; list-style-type: none; padding-left: 0;">
              <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                <li style="margin-bottom: 2px;">
                  <strong t-esc="bank.bank_id.name or 'Banco'"/>:
                  <t t-if="bank.acc_number and bank._fields.get('iban') and bank.iban">
                    <span>N.º de conta: <t t-esc="bank.acc_number"/> | IBAN: <t t-esc="bank.iban"/></span>
                  </t>
                  <t t-elif="bank._fields.get('iban') and bank.iban">
                    <span>IBAN: <t t-esc="bank.iban"/></span>
                  </t>
                  <t t-elif="bank.acc_number">
                    <span><t t-esc="bank.acc_number"/></span>
                  </t>
                </li>
              </t>
            </ul>
          </t>
          <t t-if="o.move_type == 'out_invoice'"><p>Os bens / serviços foram colocados à disposição do adquirente na data e local do documento.</p></t>
          <p t-if="o.state == 'draft'">Este Documento não serve como Factura. Nota Informativa <span t-field="o.company_id.name"/></p>
        </div>
      </div>
    </xpath>

  </template>
</odoo>
